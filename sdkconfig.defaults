# School Device ESP32 - sdkconfig defaults
# These override IDF defaults for our project

# Partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Task watchdog - increase timeout for OTA operations
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30

# WiFi
CONFIG_ESP_WIFI_NVS_ENABLED=y

# MQTT
CONFIG_MQTT_TRANSPORT_SSL=y
CONFIG_MQTT_TRANSPORT_WEBSOCKET=y

# TLS
CONFIG_ESP_TLS_USING_MBEDTLS=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
# Session resumption — keeps reconnect handshake under ~1s instead of 2-3s.
# See esp32_firmware/PROTOCOL_OPTIMIZATION.md §9.
CONFIG_MBEDTLS_SSL_SESSION_TICKETS=y
CONFIG_MBEDTLS_CLIENT_SSL_SESSION_TICKETS=y

# HTTPS OTA
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=n

# Signed firmware verification (requires signing key — generate with:
#   espsecure.py generate_signing_key --version 1 secure_boot_signing_key.pem)
# CONFIG_SECURE_SIGNED_APPS_NO_SECURE_BOOT=y
# CONFIG_SECURE_SIGNED_ON_UPDATE_NO_SECURE_BOOT=y

# NVS
CONFIG_NVS_ENCRYPTION=n

# SNTP
CONFIG_LWIP_SNTP_MAX_SERVERS=2

# FreeRTOS
CONFIG_FREERTOS_HZ=100
CONFIG_FREERTOS_CHECK_STACKOVERFLOW_CANARY=y

# Bluetooth (disabled — no BLE provisioning code, saves ~60KB RAM)
CONFIG_BT_ENABLED=n

# System
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Log level
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Flash
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
